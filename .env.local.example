# Estas variables apuntan al proyecto Supabase de DESARROLLO en este repo.
# Producción usa un proyecto Supabase separado y sus propios valores,
# cargados en el panel del host de despliegue — nunca en un archivo del repo.
# Ver supabase/README.md.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional — conexión de SOLO LECTURA a producción vía connection pooler
# (rol arcade_readonly, ver supabase/README.md). Nunca prefijar con
# NEXT_PUBLIC_: no debe llegar al bundle del cliente.
SUPABASE_PROD_READONLY_URL=